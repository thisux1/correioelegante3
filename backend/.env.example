# ==============================================================================
# Correio Elegante API - Environment Variables Template (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Aplicação & Servidor (Obrigatórias)
# ------------------------------------------------------------------------------
# Porta de execução do servidor Express (Padrão: 3000 em dev / 8080 no Cloud Run)
PORT=3000
# Ambiente de execução: development | production | test
NODE_ENV=development
# URL do frontend para configuração de CORS e redirecionamentos pós-pagamento
# Produção: https://seudominio.com.br (ou URL da Vercel)
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 2. Banco de Dados - MongoDB Atlas (Prisma) (Obrigatória)
# ------------------------------------------------------------------------------
# String de conexão do MongoDB Atlas com Replica Set (obrigatório para transações)
# Formato: mongodb+srv://<usuario>:<senha>@<cluster-host>/<nome_do_banco>?retryWrites=true&w=majority
DATABASE_URL=mongodb+srv://db_user:db_password@cluster0.mongodb.net/correioelegante?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 3. Autenticação & Segurança JWT (Obrigatórias)
# ------------------------------------------------------------------------------
# Segredo usado para assinar tokens de acesso (mínimo de 32 caracteres)
JWT_SECRET=your_jwt_access_secret_min_32_characters_here_example
# Segredo usado para assinar refresh tokens (mínimo de 32 caracteres)
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_characters_here_example

# ------------------------------------------------------------------------------
# 4. Armazenamento de Mídia & Transcoding (Cloudinary) (Obrigatória para uploads)
# ------------------------------------------------------------------------------
# Opção A: URL completa do Cloudinary (recomendada)
# Formato: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=cloudinary://123456789012345:abcdefghijklmnopqrstuvwxyz1@meu-cloud-name

# Opção B: Credenciais individuais (fallback se CLOUDINARY_URL não for informada)
CLOUDINARY_CLOUD_NAME=meu-cloud-name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=abcdefghijklmnopqrstuvwxyz1

# ------------------------------------------------------------------------------
# 5. Pagamentos - Stripe (Cartão de Crédito e Internacional)
# ------------------------------------------------------------------------------
# Chave secreta da API do Stripe (sk_test_... ou sk_live_...)
STRIPE_SECRET_KEY=sk_test_51AbcDefGhIjKlMnOpQrStUvWxYz...
# Secret de validação do webhook do Stripe (whsec_...)
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_signing_secret_here...

# ------------------------------------------------------------------------------
# 6. Pagamentos - PagBank / PagSeguro V3 (Checkout Transparente PIX & Cartão)
# ------------------------------------------------------------------------------
# Token de autenticação Bearer do PagBank (Sandbox ou Produção)
PAGBANK_TOKEN=seu_token_pagbank_bearer_aqui_exemplo
# Alias alternativo para PAGBANK_TOKEN
PAGSEGURO_TOKEN=seu_token_pagbank_bearer_aqui_exemplo
# Ambiente do PagBank: sandbox | production
PAGBANK_ENV=sandbox
# Chave pública para criptografia de cartão no frontend (Checkout Transparente)
PAGBANK_PUBLIC_KEY=sua_public_key_pagbank_aqui
# URL base customizada (Opcional - padrão é https://sandbox.api.pagseguro.com ou https://api.pagseguro.com)
# PAGBANK_BASE_URL=https://sandbox.api.pagseguro.com

# ------------------------------------------------------------------------------
# 7. Pagamentos - Mercado Pago (Preservado / Secundário)
# ------------------------------------------------------------------------------
# Access Token do Mercado Pago (APP_USR-...)
MERCADOPAGO_ACCESS_TOKEN=APP_USR-0000000000000000-000000-00000000000000000000000000000000-000000000
# Alias retrocompatível para MERCADOPAGO_ACCESS_TOKEN
MP_ACCESS_TOKEN=APP_USR-0000000000000000-000000-00000000000000000000000000000000-000000000
# Chave pública do Mercado Pago para uso no frontend/SDK
MP_PUBLIC_KEY=APP_USR-00000000-0000-0000-0000-000000000000
# Secret usado para validar o cabeçalho x-signature dos webhooks do Mercado Pago
MERCADOPAGO_WEBHOOK_SECRET=your_mercadopago_webhook_signature_secret_here
# URL pública para notificação de webhooks do Mercado Pago
MERCADOPAGO_NOTIFICATION_URL=https://api.seudominio.com.br/api/payments/webhook/mercadopago
# Tempo de expiração do QR Code Pix em minutos (padrão: 30)
PIX_EXPIRATION_MINUTES=30

