# App
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Auth
JWT_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here

# Database (Prisma)
# Example: postgresql://user:password@localhost:5432/db_name?schema=public
DATABASE_URL="file:./dev.db"

# Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Payments (Stripe)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Payments (Mercado Pago)
MP_ACCESS_TOKEN=APP_USR-...
MP_PUBLIC_KEY=APP_USR-...
# Secret usado para validar a assinatura (x-signature) dos webhooks do MP
MERCADOPAGO_WEBHOOK_SECRET=your_webhook_secret_here
# URL pública do webhook de pagamentos do MP (ex.: https://api.seudominio.com/api/payments/webhook/mercadopago)
MERCADOPAGO_NOTIFICATION_URL=https://api.seudominio.com/api/payments/webhook/mercadopago
# Expiração do QR Code Pix em minutos (padrão: 30)
PIX_EXPIRATION_MINUTES=30
